# "production" enforces TLS and secrets, "development" is for local testing
ENV=production

DEBUG=false

# Port 25 needs CAP_NET_BIND_SERVICE or root on Linux
SMTP_PORT=25

# Leave empty to disable the submission listener
SMTP_SUBMISSION_PORT=

HTTP_PORT=8081

# Used for HELO/EHLO and reverse DNS
SERVER_HOSTNAME=mail.yourdomain.com
SERVER_ID=default

TLS_CERT_FILE=/etc/letsencrypt/live/mail.yourdomain.com/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/mail.yourdomain.com/privkey.pem

# Must match backend/server/.env
AUTH_TOKEN=generate-a-strong-32-character-token-here
AES_KEY=generate-a-strong-32-character-aes-key-here

# MB, RAM ring buffer before spilling to disk
MAX_RAM_MB=64

# MB, disk spool cap
MAX_DISK_MB=500

MAX_DISK_MESSAGES=10000
SQLITE_PATH=smtp_spool.db

# MB
MAX_MESSAGE_MB=25

MAX_RECIPIENTS=50
SMTP_READ_TIMEOUT_SEC=30
SMTP_WRITE_TIMEOUT_SEC=30

OUTBOUND_SMTP_PORT=25
OUTBOUND_DIAL_TIMEOUT_SEC=10
OUTBOUND_BODY_LIMIT_MB=64

WS_WRITE_TIMEOUT_SEC=30
MAX_CIPHERTEXT_MB=100
MAX_PART_SIZE_MB=25
MAX_INLINE_IMAGE_MB=10
