HTTP_PORT=8082

# "live" for multi-tenant production, "local" for a single-tenant standalone setup
MODE=live

ADMIN_EMAIL=admin@example.com

SERVER_HOSTNAME=mail.yourdomain.com

# Must match backend/smtp/.env
AUTH_TOKEN=generate-a-strong-32-character-token-here
AES_KEY=generate-a-strong-32-character-aes-key-here

SMTP_SERVICE_URL=http://localhost:8081
SMTP_SERVICE_WS=ws://localhost:8081/ws

# Seconds between background domain/alias pushes to the edge node
DOMAIN_SYNC_INTERVAL_SEC=60

CENTRAL_DB_PATH=central_backend.db
STORAGE_PATH=data/storage
BASE_USERS_DIR=data/users

# Consecutive DNS check failures before a domain is flagged as degraded
DNS_FAIL_THRESHOLD=3

# Minutes between background DNS verification runs
DNS_CHECK_INTERVAL_MINUTES=5

# Seconds of cooldown between manual DNS re-checks
DNS_RATE_LIMIT_SECONDS=30

DNS_TIMEOUT_SECONDS=5
DNS_RESOLVER=1.1.1.1:53

# "*" during development, or an explicit origin
CORS_ALLOWED_ORIGINS=*

HTTP_READ_TIMEOUT_SEC=10
HTTP_IDLE_TIMEOUT_SEC=120

# MB, internal sync frames
RELAY_WS_READ_LIMIT_MB=64

RELAY_RECONNECT_INTERVAL_SEC=3
RELAY_PING_INTERVAL_SEC=20
RELAY_READ_DEADLINE_SEC=60

# MB, per mailbox
DEFAULT_MAILBOX_QUOTA_MB=100

# GB, per user account
MAX_USER_QUOTA_GB=50

# MB
MAX_ATTACHMENT_MB=25
MAX_CIPHERTEXT_MB=100
MAX_PART_SIZE_MB=25
MAX_INLINE_IMAGE_MB=10
